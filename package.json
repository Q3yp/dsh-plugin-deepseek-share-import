{
  "name": "dsh-plugin-deepseek-share-import",
  "version": "0.1.0",
  "description": "Import public DeepSeek share links as local DeepSeek Harness sessions.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "build.mjs"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit",
    "browser:install": "playwright install chromium",
    "prepack": "npm run check && npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-deepseek-chat-import": "0.2.2-rc.3",
    "playwright": "^1.56.1",
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-brand": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-session-persistence": "*",
    "@deepseek-ai/dsh-workspace": "*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.3",
    "@deepseek-ai/dsh-credentials-local": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-session-persistence-jsonl": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-session-projection-cache": "0.2.2-rc.3",
    "@deepseek-ai/dsh-storage-json": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.28.2",
    "react": "^18.3.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Q3yp/dsh-plugin-deepseek-share-import.git"
  },
  "homepage": "https://github.com/Q3yp/dsh-plugin-deepseek-share-import#readme",
  "bugs": {
    "url": "https://github.com/Q3yp/dsh-plugin-deepseek-share-import/issues"
  },
  "author": "Peng Yue",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "chat-import"
  ]
}
